      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    users {\n        INTEGER user_id PK \&quot;AUTOINCREMENT\&quot;\n        TEXT username UK \&quot;NOT NULL\&quot;\n        TEXT pin_hash \&quot;salted hash, NOT NULL\&quot;\n        TEXT name \&quot;NOT NULL\&quot;\n        TEXT role \&quot;CHECK admin, cashier\&quot;\n        INTEGER status \&quot;0/1, DEFAULT 1\&quot;\n        TEXT recovery_hash \&quot;NULL, admin only\&quot;\n    }\n\n    categories {\n        INTEGER category_id PK \&quot;AUTOINCREMENT\&quot;\n        TEXT name UK \&quot;NOT NULL\&quot;\n        INTEGER status \&quot;0/1, DEFAULT 1\&quot;\n    }\n\n    products {\n        INTEGER product_id PK \&quot;AUTOINCREMENT\&quot;\n        TEXT barcode UK \&quot;NULL if no barcode\&quot;\n        TEXT name \&quot;NOT NULL\&quot;\n        INTEGER category_id FK \&quot;categories.category_id\&quot;\n        INTEGER price \&quot;&gt; 0\&quot;\n        INTEGER cost_price \&quot;&gt;= 0, DEFAULT 0\&quot;\n        INTEGER stock \&quot;CHECK &gt;= 0, DEFAULT 0\&quot;\n        INTEGER min_stock \&quot;NULL = default_min_stock\&quot;\n        TEXT photo \&quot;NULL\&quot;\n        INTEGER status \&quot;0/1, DEFAULT 1\&quot;\n    }\n\n    transactions {\n        INTEGER transaction_id PK \&quot;AUTOINCREMENT\&quot;\n        INTEGER user_id FK \&quot;users.user_id\&quot;\n        TEXT receipt_no UK \&quot;TRX-yyyymmdd-nnn\&quot;\n        TEXT date \&quot;ISO 8601, NOT NULL\&quot;\n        TEXT method \&quot;CHECK cash, qris, credit\&quot;\n        INTEGER total \&quot;&gt; 0\&quot;\n        INTEGER paid \&quot;credit = 0\&quot;\n        INTEGER change_due \&quot;credit/qris = 0\&quot;\n        INTEGER total_cost \&quot;sum(cost x qty)\&quot;\n        INTEGER gross_profit \&quot;total - total_cost\&quot;\n        TEXT note \&quot;NULL\&quot;\n    }\n\n    transaction_items {\n        INTEGER item_id PK \&quot;AUTOINCREMENT\&quot;\n        INTEGER transaction_id FK \&quot;transactions.transaction_id\&quot;\n        INTEGER product_id FK \&quot;products.product_id\&quot;\n        INTEGER quantity \&quot;&gt; 0\&quot;\n        INTEGER price \&quot;copied at sale time\&quot;\n        INTEGER cost_price \&quot;copied at sale time\&quot;\n        INTEGER subtotal \&quot;price x quantity\&quot;\n    }\n\n    stock_movements {\n        INTEGER movement_id PK \&quot;AUTOINCREMENT\&quot;\n        INTEGER product_id FK \&quot;products.product_id\&quot;\n        INTEGER user_id FK \&quot;users.user_id\&quot;\n        INTEGER transaction_id FK \&quot;NULL, sale only\&quot;\n        TEXT date \&quot;ISO 8601\&quot;\n        TEXT type \&quot;CHECK initial, restock, sale, adjustment\&quot;\n        INTEGER quantity_change \&quot;signed, never 0\&quot;\n        INTEGER stock_after \&quot;&gt;= 0\&quot;\n        INTEGER unit_cost \&quot;NULL, restock only\&quot;\n        INTEGER total_cost \&quot;NULL, restock only\&quot;\n        TEXT note \&quot;required for adjustment\&quot;\n    }\n\n    debts {\n        INTEGER debt_id PK \&quot;AUTOINCREMENT\&quot;\n        INTEGER transaction_id FK \&quot;UNIQUE, NULL = manual note\&quot;\n        INTEGER user_id FK \&quot;users.user_id\&quot;\n        TEXT customer_name \&quot;NOT NULL\&quot;\n        TEXT date \&quot;ISO 8601\&quot;\n        INTEGER total_amount \&quot;&gt; 0\&quot;\n        INTEGER paid_amount \&quot;DEFAULT 0, &lt;= total\&quot;\n        TEXT status \&quot;CHECK unpaid, paid\&quot;\n        TEXT note \&quot;NULL\&quot;\n    }\n\n    debt_payments {\n        INTEGER payment_id PK \&quot;AUTOINCREMENT\&quot;\n        INTEGER debt_id FK \&quot;debts.debt_id\&quot;\n        INTEGER user_id FK \&quot;users.user_id\&quot;\n        TEXT date \&quot;ISO 8601\&quot;\n        TEXT method \&quot;CHECK cash, qris\&quot;\n        INTEGER amount \&quot;&gt; 0\&quot;\n        TEXT note \&quot;NULL\&quot;\n    }\n\n    finance {\n        INTEGER finance_id PK \&quot;AUTOINCREMENT\&quot;\n        INTEGER user_id FK \&quot;users.user_id\&quot;\n        TEXT date \&quot;ISO 8601\&quot;\n        TEXT type \&quot;CHECK income, expense\&quot;\n        TEXT category \&quot;NOT NULL\&quot;\n        INTEGER amount \&quot;&gt; 0\&quot;\n        TEXT description \&quot;NULL\&quot;\n    }\n\n    settings {\n        INTEGER settings_id PK \&quot;CHECK = 1 (single row)\&quot;\n        TEXT store_name \&quot;NOT NULL\&quot;\n        TEXT store_address \&quot;NULL\&quot;\n        TEXT receipt_footer \&quot;NULL\&quot;\n        INTEGER default_min_stock \&quot;DEFAULT 5\&quot;\n        TEXT qris_bank \&quot;NULL\&quot;\n        TEXT qris_owner_name \&quot;NULL\&quot;\n        TEXT qris_image \&quot;NULL = QRIS not set\&quot;\n        INTEGER target_daily \&quot;NULL\&quot;\n        INTEGER target_weekly \&quot;NULL\&quot;\n        INTEGER target_monthly \&quot;NULL\&quot;\n        INTEGER auto_lock_minutes \&quot;DEFAULT 5\&quot;\n        TEXT backup_folder \&quot;NULL\&quot;\n        TEXT last_backup_at \&quot;NULL\&quot;\n    }\n\n    users ||--o{ transactions : \&quot;serves\&quot;\n    users ||--o{ stock_movements : \&quot;records\&quot;\n    users ||--o{ debts : \&quot;records\&quot;\n    users ||--o{ debt_payments : \&quot;receives\&quot;\n    users ||--o{ finance : \&quot;records\&quot;\n    categories ||--o{ products : \&quot;has\&quot;\n    transactions ||--|{ transaction_items : \&quot;has\&quot;\n    products ||--o{ transaction_items : \&quot;sold in\&quot;\n    products ||--o{ stock_movements : \&quot;has\&quot;\n    transactions |o--o{ stock_movements : \&quot;caused by sale\&quot;\n    transactions |o--o| debts : \&quot;credit sale\&quot;\n    debts ||--o{ debt_payments : \&quot;has\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="FDPuw9sX35b2hGSJd5bY-1">
