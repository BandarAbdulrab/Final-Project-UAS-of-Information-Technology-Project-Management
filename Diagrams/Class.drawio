  <diagram name="‫الصفحة-1‬" id="tLF6tr8AFZGdTYM_tTDw">
    <mxGraphModel dx="5189" dy="3578" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class User {\n        - user_id : Long [PK]\n        - username : String [unique]\n        - pin_hash : String\n        - name : String\n        - role : String\n        - status : Int\n        - recovery_hash : String\n        + login(username, pin) Boolean\n        + lock() void\n        + changePin(currentPin, newPin) Boolean\n        + addUser() void\n        + editUser() void\n        + setActive(active) void\n        + resetPin() void\n        + resetAdminPin(recoveryCode) Boolean\n    }\n\n    class Category {\n        - category_id : Long [PK]\n        - name : String [unique]\n        - status : Int\n        + addCategory() void\n        + renameCategory() void\n        + setActive(active) void\n    }\n\n    class Product {\n        - product_id : Long [PK]\n        - barcode : String [unique]\n        - name : String\n        - category_id : Long [FK]\n        - price : Int\n        - cost_price : Int\n        - stock : Int\n        - min_stock : Int\n        - photo : String\n        - status : Int\n        + addProduct() void\n        + editProduct() void\n        + setActive(active) void\n        + findByBarcode(code) Product\n        + search(keyword) List\n        + getStockStatus() String\n    }\n\n    class Cart {\n        «in-memory»\n        - items : List\n        - method : String\n        - paid : Int\n        - customer_name : String\n        - note : String\n        + addByBarcode(code) void\n        + addProduct(productId) void\n        + changeQuantity(productId, qty) void\n        + removeItem(productId) void\n        + getTotal() Int\n        + calculateChange() Int\n        + isEmpty() Boolean\n    }\n\n    class CartItem {\n        «in-memory»\n        - product_id : Long\n        - quantity : Int\n        - price : Int\n        - cost_price : Int\n        + getSubtotal() Int\n    }\n\n    class Transaction {\n        - transaction_id : Long [PK]\n        - user_id : Long [FK]\n        - receipt_no : String [unique]\n        - date : String\n        - method : String\n        - total : Int\n        - paid : Int\n        - change_due : Int\n        - total_cost : Int\n        - gross_profit : Int\n        - note : String\n        + generateReceiptNo() String\n        + completeTransaction(cart) Boolean\n        + calculateProfit() Int\n        + composeReceipt() String\n        + shareReceipt() void\n        + printReceipt() void\n        + viewHistory(period, method, sort) List\n    }\n\n    class TransactionItem {\n        - item_id : Long [PK]\n        - transaction_id : Long [FK]\n        - product_id : Long [FK]\n        - quantity : Int\n        - price : Int\n        - cost_price : Int\n        - subtotal : Int\n        + calculateSubtotal() Int\n    }\n\n    class StockMovement {\n        - movement_id : Long [PK]\n        - product_id : Long [FK]\n        - user_id : Long [FK]\n        - transaction_id : Long [FK]\n        - date : String\n        - type : String\n        - quantity_change : Int\n        - stock_after : Int\n        - unit_cost : Int\n        - total_cost : Int\n        - note : String\n        + recordRestock(qty, unitCost) void\n        + recordAdjustment(counted, reason) void\n        + recordSale(item) void\n        + viewHistory(productId) List\n    }\n\n    class Debt {\n        - debt_id : Long [PK]\n        - transaction_id : Long [FK, unique]\n        - user_id : Long [FK]\n        - customer_name : String\n        - date : String\n        - total_amount : Int\n        - paid_amount : Int\n        - status : String\n        - note : String\n        + createFromSale(transaction) void\n        + addManualDebt() void\n        + editManualDebt() void\n        + deleteManualDebt() void\n        + getRemaining() Int\n        + updateStatus() void\n    }\n\n    class DebtPayment {\n        - payment_id : Long [PK]\n        - debt_id : Long [FK]\n        - user_id : Long [FK]\n        - date : String\n        - method : String\n        - amount : Int\n        - note : String\n        + recordPayment(qrisConfirmed) Boolean\n    }\n\n    class FinanceRecord {\n        - finance_id : Long [PK]\n        - user_id : Long [FK]\n        - date : String\n        - type : String\n        - category : String\n        - amount : Int\n        - description : String\n        + record() void\n        + edit() void\n        + delete() void\n    }\n\n    class Settings {\n        «configuration»\n        - settings_id : Int [PK]\n        - store_name : String\n        - store_address : String\n        - receipt_footer : String\n        - default_min_stock : Int\n        - qris_bank : String\n        - qris_owner_name : String\n        - qris_image : String\n        - target_daily : Int\n        - target_weekly : Int\n        - target_monthly : Int\n        - auto_lock_minutes : Int\n        - backup_folder : String\n        - last_backup_at : String\n        + getSettings() Settings\n        + saveSettings() void\n        + isQrisConfigured() Boolean\n    }\n\n    class Report {\n        «report»\n        - revenue : Int\n        - gross_profit : Int\n        - other_income : Int\n        - operating_expenses : Int\n        - net_profit : Int\n        - cash_balance : Int\n        - outstanding_debt : Int\n        + generate(period) Report\n        + salesPerCategory() List\n        + salesPerProduct(sort) List\n        + targetProgress() Map\n        + exportPdf() void\n        + exportCsv() void\n    }\n\n    class BackupManager {\n        «service»\n        + backupNow(destination) Boolean\n        + scheduleDailyBackup() void\n        + purgeOldBackups(keep) void\n        + validateBackup(file) Boolean\n        + restore(file) Boolean\n        + needsReminder() Boolean\n    }\n\n    User \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Transaction : serves\n    User \&quot;1\&quot; --&gt; \&quot;0..*\&quot; StockMovement : records\n    User \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Debt : records\n    User \&quot;1\&quot; --&gt; \&quot;0..*\&quot; DebtPayment : receives\n    User \&quot;1\&quot; --&gt; \&quot;0..*\&quot; FinanceRecord : records\n    Category \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Product : has\n    Transaction \&quot;1\&quot; *-- \&quot;1..*\&quot; TransactionItem : has\n    Product \&quot;1\&quot; --&gt; \&quot;0..*\&quot; TransactionItem : sold in\n    Product \&quot;1\&quot; --&gt; \&quot;0..*\&quot; StockMovement : has\n    StockMovement \&quot;0..*\&quot; --&gt; \&quot;0..1\&quot; Transaction : caused by sale\n    Transaction \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Debt : creates (credit sale)\n    Debt \&quot;1\&quot; *-- \&quot;0..*\&quot; DebtPayment : has\n\n    Cart \&quot;1\&quot; *-- \&quot;1..*\&quot; CartItem : contains\n    Cart ..&gt; Product : «use»\n    Cart ..&gt; Transaction : «create»\n    Settings ..&gt; Product : «use»\n    Report ..&gt; Transaction : «use»\n    Report ..&gt; TransactionItem : «use»\n    Report ..&gt; Debt : «use»\n    Report ..&gt; DebtPayment : «use»\n    Report ..&gt; StockMovement : «use»\n    Report ..&gt; FinanceRecord : «use»\n    BackupManager ..&gt; Settings : «use»&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="CQ6c5DsYQzHDOF4Ha1uD-1">
